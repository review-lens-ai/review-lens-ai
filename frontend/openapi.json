    },
    "/api/v1/targets": {
      "get": {
        "tags": [
          "targets"
        ],
        "summary": "List Targets",
        "description": "S1-017: only the signed-in user's targets. The owner filter runs in SQL\n(TargetRepository.list_for_owner), not in the browser.",
        "operationId": "list_targets",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "targets"
        ],
        "summary": "Create Target",
        "description": "S1-015: create a target owned by the signed-in user.",
        "operationId": "create_target",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TargetCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/targets/{target_id}": {
      "get": {
        "tags": [
          "targets"
        ],
        "summary": "Get Target",
        "description": "S1-018: one target for its workspace. Another user's target is a 404,\nindistinguishable from one that does not exist.",
        "operationId": "get_target",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Target Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TargetResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "targets"
        ],
        "summary": "Delete Target",
        "description": "S1-012: delete one of your own targets. Another user's target is a 404.",
        "operationId": "delete_target",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Target Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/targets/{target_id}/reviews": {
      "get": {
        "tags": [
          "targets"
        ],
        "summary": "List Target Reviews",
        "description": "S1-022: one page of a target's saved reviews, through its owner only.\nAnother user's target is a 404, indistinguishable from one that does not exist.\n\naround: the id of one review. The page that holds it is returned (offset is\nignored), so a link to a review can open on the right page. A review that is\nnot in this target is a 404 too.\n\nKnown limits, accepted for now:\n- items and total are two queries. A run that commits between them makes\n  total count reviews the page did not see.\n- A run that finishes while someone pages shifts the rows, so the next page\n  can repeat a few reviews. The UI goes back to page 1 when a run finishes.\n- Future: one repository method that checks the owner once and returns\n  (rows, total) would save a round trip and could read both in one snapshot.",
        "operationId": "list_target_reviews",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Target Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100000,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "around",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Around"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewPage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/targets/{target_id}/summary": {
      "get": {
        "tags": [
          "targets"
        ],
        "summary": "Get Target Summary",
        "description": "S2-008: review count, average rating and rating counts for one of the\nuser's targets, calculated from its saved reviews (the same dataset Q&A uses).\nAnother user's target is a 404, indistinguishable from one that does not exist.",
        "operationId": "get_target_summary",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Target Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewSummary"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/targets/{target_id}/ingestion-runs": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Start Ingestion Run",
        "description": "S1-019: queue an ingestion run for one of the user's targets. Returns at\nonce with the QUEUED run; the worker does the work and the workspace polls\n.../latest for progress. Another user's target is a 404 before anything is\nqueued, and a second active run is a 409.",
        "operationId": "start_ingestion_run",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Target Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionRunResponse"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          }
        }
      }
    },
    "/api/v1/targets/{target_id}/ingestion-runs/latest": {
      "get": {
        "tags": [
          "ingestion"
        ],
        "summary": "Get Latest Ingestion Run",
        "description": "S1-023: the newest ingestion attempt for one of the user's targets, so the\nworkspace can show running / succeeded / failed. `run` is null when the\ntarget was never ingested. S2-007: `skipped_reasons` says why the run\nskipped records (codes and counts only).",
        "operationId": "get_latest_ingestion_run",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Target Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestIngestionRun"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CurrentUserResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "email"
        ],
        "title": "CurrentUserResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "The body of every /api/v1 error response."
      },
      "FieldIssue": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "FieldIssue"
      },
      "IngestionRunResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "target_id": {
            "type": "string",
            "format": "uuid",
            "title": "Target Id"
          },
          "job_type": {
            "type": "string",
            "enum": [
              "INGESTION",
              "ENRICHMENT"
            ],
            "title": "Job Type"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "COMPLETED",
              "PARTIAL",
              "FAILED"
            ],
            "title": "Status"
          },
          "queued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Queued At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "reviews_ingested": {
            "type": "integer",
            "title": "Reviews Ingested"
          },
          "reviews_rejected": {
            "type": "integer",
            "title": "Reviews Rejected"
          },
          "reviews_duplicate": {
            "type": "integer",
            "title": "Reviews Duplicate"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "type": "object",
        "required": [
          "id",
          "target_id",
          "job_type",
          "status",
          "queued_at",
          "started_at",
          "finished_at",
          "reviews_ingested",
          "reviews_rejected",
          "reviews_duplicate",
          "error_code"
        ],
        "title": "IngestionRunResponse",
        "description": "One ingestion attempt, as the workspace shows it (S1-023)."
      },
      "LatestIngestionRun": {
        "properties": {
          "run": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/IngestionRunResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "skipped_reasons": {
            "items": {
              "$ref": "#/components/schemas/SkippedReason"
            },
            "type": "array",
            "title": "Skipped Reasons",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "run"
        ],
        "title": "LatestIngestionRun",
        "description": "`run` is None when the target has never been ingested.\n\n`skipped_reasons` explains the run's skipped records, most common reason\nfirst. It is empty when nothing was skipped. Counts only: the skipped\nrecords themselves are never sent."
      },
      "RatingCount": {
        "properties": {
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "rating",
          "count"
        ],
        "title": "RatingCount",
        "description": "How many of the target's reviews have one star rating (S2-008)."
      },
      "ReviewPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReviewResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "ReviewPage"
      },
      "ReviewResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "target_id": {
            "type": "string",
            "format": "uuid",
            "title": "Target Id"
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "rating": {
            "type": "integer",
            "title": "Rating"
          },
          "review_text": {
            "type": "string",
            "title": "Review Text"
          },
          "mapping_version": {
            "type": "string",
            "title": "Mapping Version"
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reviewed At"
          },
          "source_review_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Review Id"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "source_metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Source Metadata"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "target_id",
          "run_id",
          "rating",
          "review_text",
          "mapping_version",
          "reviewed_at",
          "source_review_id",
          "source_url",
          "source_metadata",
          "created_at"
        ],
        "title": "ReviewResponse"
      },
      "ReviewSummary": {
        "properties": {
          "review_count": {
            "type": "integer",
            "title": "Review Count"
          },
          "average_rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Rating"
          },
          "rating_counts": {
            "items": {
              "$ref": "#/components/schemas/RatingCount"
            },
            "type": "array",
            "title": "Rating Counts"
          },
          "first_reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Reviewed At"
          },
          "last_reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Reviewed At"
          }
        },
        "type": "object",
        "required": [
          "review_count",
          "average_rating",
          "rating_counts",
          "first_reviewed_at",
          "last_reviewed_at"
        ],
        "title": "ReviewSummary",
        "description": "S2-008: the summary of a target's active dataset, the same saved reviews\nQ&A reads. Calculated from the reviews table, never from a run's counters."
      },
      "SkippedReason": {
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "NOT_A_RECORD",
              "MISSING_TEXT",
              "MISSING_RATING",
              "INVALID_RATING",
              "OTHER"
            ],
            "title": "Reason"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "count"
        ],
        "title": "SkippedReason",
        "description": "How many of a run's records were skipped for one reason (S2-007)."
      },
      "TargetCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "source_url"
        ],
        "title": "TargetCreate",
        "description": "What a client may send when creating a target.\n\nThere is deliberately NO owner_id / user_id field: ownership comes only from\nthe verified token (S1-BR-010). Any such key a client adds is ignored.\nThe platform is fixed by app.platforms, so it is not sent either."
      },
      "TargetList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TargetResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "TargetList"
      },
      "TargetResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "platform": {
            "type": "string",
            "title": "Platform"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "ingestion_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "QUEUED",
                  "RUNNING",
                  "COMPLETED",
                  "PARTIAL",
                  "FAILED"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingestion Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "platform",
          "source_url",
          "ingestion_status",
          "created_at",
          "updated_at"
        ],
        "title": "TargetResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
